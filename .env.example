# Développement local (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Production Vercel — Turso (SQLite cloud gratuit)
# Créer sur https://turso.tech → New Database → copier l'URL et le token
TURSO_DATABASE_URL=libsql://votre-db.turso.io
TURSO_AUTH_TOKEN=votre_token_turso

NEXT_PUBLIC_SITE_URL=https://yogaops.fr
NEXT_PUBLIC_STUDIO_NAME=YogaOps

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Zoom (future API automation)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email SMTP (confirmation client + copie prof)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="YogaOps <no-reply@yogaops.fr>"

# Vercel Blob — stockage des images uploadées depuis le backoffice
# Générer dans : Vercel Dashboard → Storage → Blob → Create Store → puis copier le token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Backoffice auth
ADMIN_EMAIL=contact@yogaops.fr
ADMIN_BACKOFFICE_PIN=votre_code_secret
NEXTAUTH_SECRET=change-me
