// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum CourseType {
  individuel
  collectif
}

enum LocationType {
  en_ligne
  presentiel
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

enum PaymentMethod {
  stripe
  on_site
  subscription
}

enum SubscriptionStatus {
  pending
  active
  cancelled
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String
  type        CourseType
  location    LocationType
  durationMin Int
  priceEur    Int
  capacity    Int
  isActive    Boolean      @default(true)
  slots       TimeSlot[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TimeSlot {
  id         String    @id @default(cuid())
  courseId   String
  startsAt   DateTime
  available  Int
  booked     Int       @default(0)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([courseId, startsAt])
}

model Booking {
  id            String        @id @default(cuid())
  customerName  String
  customerEmail String
  status        BookingStatus @default(pending)
  paymentMethod PaymentMethod
  zoomLink      String?
  slotId        String
  slot          TimeSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
}

model PackagePlan {
  id           String   @id @default(cuid())
  name         String
  description  String
  priceEur     Int
  sessionCount Int
  allowedCourseType CourseType?
  validityDays Int
  isActive     Boolean  @default(true)
  subscriptions Subscription[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Subscription {
  id            String              @id @default(cuid())
  customerEmail String
  status        SubscriptionStatus  @default(pending)
  paymentMethod PaymentMethod      @default(subscription)

  packageId     String
  package       PackagePlan         @relation(fields: [packageId], references: [id])

  startsAt      DateTime           @default(now())
  endsAt        DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  weeks         SubscriptionWeek[]
  bookings      Booking[]
}

model SubscriptionWeek {
  id                String              @id @default(cuid())
  subscriptionId    String
  subscription      Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  weekStart         DateTime
  remainingSessions Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([subscriptionId, weekStart])
}
